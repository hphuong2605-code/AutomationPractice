<?xml version="1.0" encoding="UTF-8"?>
<Configuration status="WARN">
    <Appenders>

        <Console name="Console">
            <PatternLayout
                    pattern="%d{HH:mm:ss} %-5level %msg%n"/>
        </Console>

        <File
                name="File"
                fileName="reports/test.log">

            <PatternLayout
                    pattern="%d %-5level %c - %msg%n"/>

        </File>

    </Appenders>

    <Loggers>

        <Root level="info">

            <AppenderRef ref="Console"/>

            <AppenderRef ref="File"/>

        </Root>

    </Loggers>

</Configuration>